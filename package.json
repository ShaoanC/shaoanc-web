{
  "name": "www.shaoanc.cn",
  "version": "1.0.0",
  "description": "ShaoanC 的个人网站与智能错题整理系统",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "vite --config client/mistakes/vite.config.mts",
    "typecheck": "tsc --project client/mistakes/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build --config client/mistakes/vite.config.mts",
    "test": "node scripts/mistakes-smoke.cjs && node scripts/mistakes-captcha-smoke.cjs",
    "test:ai": "node scripts/mistakes-ai-smoke.cjs",
    "test:pages": "node scripts/mistakes-page-smoke.cjs",
    "test:client": "node scripts/mistakes-editor-smoke.cjs && node scripts/mistakes-page-upload-smoke.cjs",
    "test:export": "node scripts/mistakes-export-smoke.cjs",
    "test:export-preview": "node scripts/mistakes-export-preview-smoke.cjs",
    "test:export-practice": "node scripts/mistakes-practice-export-smoke.cjs",
    "test:backup": "node scripts/mistakes-backup-smoke.cjs",
    "baseline:ai": "node scripts/mistakes-ai-baseline.cjs",
    "admin:create": "node server/mistakes/create-admin.js",
    "backup:restore": "node scripts/mistakes-backup-restore.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@friendlycaptcha/sdk": "1.1.1",
    "@ncdai/react-wheel-picker": "1.2.3",
    "better-sqlite3": "^13.0.3",
    "browser-image-compression": "^2.0.2",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.1",
    "katex": "^0.16.47",
    "lucide-react": "^1.52.0",
    "minisearch": "^7.2.0",
    "multer": "^2.4.0",
    "p-queue": "^10.0.0",
    "p-retry": "^8.0.1",
    "pdfjs-dist": "6.4.299",
    "photoswipe": "^5.4.4",
    "pinyin-match": "1.2.10",
    "playwright": "1.64.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-image-crop": "^11.1.2",
    "react-is": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-photoswipe-gallery": "^4.1.2",
