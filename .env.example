PORT=3000
NODE_ENV=development
MISTAKES_DB_PATH=./data/mistakes.sqlite
FRIENDLY_CAPTCHA_ENABLED=false
FRIENDLY_CAPTCHA_SITEKEY=
FRIENDLY_CAPTCHA_API_KEY=
MISTAKES_UPLOADS_PATH=./uploads/mistakes
# 管理员保存 Gemini 原生接口配置到此文件；原有 MISTAKES_AI_* 配置键保持不变。
# 基础地址示例：https://generativelanguage.googleapis.com/v1beta，或兼容 Gemini 原生协议的代理。
MISTAKES_AI_CONFIG_PATH=./.env.ai
