PORT=3000
NODE_ENV=development
MISTAKES_DB_PATH=./data/mistakes.sqlite
FRIENDLY_CAPTCHA_ENABLED=false
FRIENDLY_CAPTCHA_SITEKEY=
FRIENDLY_CAPTCHA_API_KEY=
MISTAKES_UPLOADS_PATH=./uploads/mistakes
# 备份仅保存在静态目录之外，自动备份在管理员设置中开启。
MISTAKES_BACKUPS_PATH=./data/backups
# 可选：实际部署环境文件的位置，用于归档和恢复；不导出进程环境变量。
MISTAKES_ENV_PATH=./.env
# PDF 浏览器默认保存在项目的 data/.playwright；安装和运行应使用同一路径。
PLAYWRIGHT_BROWSERS_PATH=./data/.playwright
# 可选：使用已安装 Chrome/Chromium 的绝对路径，留空使用 Playwright 配套浏览器。
MISTAKES_PDF_EXECUTABLE_PATH=
# 管理员保存 Gemini 原生接口配置到此文件；原有 MISTAKES_AI_* 配置键保持不变。
# 基础地址示例：https://generativelanguage.googleapis.com/v1beta，或兼容 Gemini 原生协议的代理。
MISTAKES_AI_CONFIG_PATH=./.env.ai
